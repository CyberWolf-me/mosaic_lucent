{
  "name": "@lucent/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude e2e/** --testTimeout=20000",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node ../../scripts/build-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@lucent/ai": "*",
    "@lucent/core": "*",
    "@lucent/i18n": "*",
    "elkjs": "0.12.0",
    "livekit-client": "2.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "iconoir": "^7.12.1",
    "simple-icons": "^16.32.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
