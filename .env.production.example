# ==============================================================================
# Lucent Production Environment Template
# ==============================================================================
# Copy this file to `packages/server/.env` (or supply via Kubernetes Secrets /
# AWS Secrets Manager / Vault / Docker env file).
#
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# --- Node Runtime & Host Bindings ---
NODE_ENV=production
LUCENT_HOST=0.0.0.0
LUCENT_PORT=4387
# Public origin used for CORS, CSRF cookie domain, and OAuth callbacks:
LUCENT_WEB_ORIGIN=https://app.yourdomain.com

# --- Authentication & Session Security ---
LUCENT_REQUIRE_AUTH=1
# Session Secret: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUCENT_SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string
LUCENT_AUTH_LIMIT_PER_WINDOW=10
LUCENT_AUTH_LIMIT_WINDOW_MS=300000

# --- Database (Postgres 16) ---
# Lucent automatically applies migrations on boot when this is set.
LUCENT_DATABASE_URL=postgres://lucent_user:db_password@postgres-host:5432/lucent_prod?sslmode=require

# --- Persistent Blob Storage (Assets, Images, Uploads) ---
LUCENT_ASSET_BACKEND=s3
LUCENT_S3_BUCKET=lucent-production-assets
LUCENT_S3_REGION=us-east-1
LUCENT_S3_ACCESS_KEY_ID=your_aws_access_key
LUCENT_S3_SECRET_ACCESS_KEY=your_aws_secret_key
# Optional S3 endpoint for Cloudflare R2 / MinIO / Backblaze B2:
# LUCENT_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- AI Provider ---
# BEFORE onboarding real users: point this at a FIRST-PARTY provider with a
# signed DPA and contractual no-training terms (Anthropic or Azure OpenAI),
# never an anonymous reseller gateway — board content, documents and transcripts
# egress here, and "is our data used to train?" must have a real answer.
LUCENT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
# No time limit on a generation (a slow model finishes instead of being cut off);
# the stream heartbeats so a proxy won't drop it. Set a number of ms to cap.
LUCENT_AI_TIMEOUT_MS=0
# Let developers bring their own provider key (sent per-request, never stored):
# their own model does the generation, which sidesteps the shared gateway for
# the developer/MCP path. Off unless set to 1.
LUCENT_ALLOW_BYO_KEYS=1
# Alternative: OpenAI or OpenAI-compatible gateway (e.g. OpenRouter / GoRouter)
# LUCENT_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# LUCENT_AI_BASE_URL=https://openrouter.ai/api/v1
# LUCENT_AI_KEY=sk-or-...
# LUCENT_AI_MODEL=anthropic/claude-3.5-sonnet

# Optional Diagram Illustration Image Provider:
# LUCENT_IMAGE_KEY=sk-proj-...
# LUCENT_IMAGE_BASE_URL=https://api.openai.com/v1
# LUCENT_IMAGE_MODEL=dall-e-3

# Optional vector generation (Icons & vectors → Generate):
# LUCENT_RECRAFT_API_KEY=...
# LUCENT_RECRAFT_MODEL=recraftv4_1_vector

# --- Transactional Mailer (Verification, Password Reset, Team Invites) ---
# Option A: HTTP Provider (Resend recommended default)
LUCENT_MAIL_TRANSPORT=http
LUCENT_MAIL_API_KEY=re_your_resend_api_key
LUCENT_MAIL_ENDPOINT=https://api.resend.com/emails
LUCENT_MAIL_FROM="Lucent <noreply@yourdomain.com>"

# Option B: Postmark via HTTP API
# LUCENT_MAIL_TRANSPORT=http
# LUCENT_MAIL_API_KEY=your_postmark_server_token
# LUCENT_MAIL_ENDPOINT=https://api.postmarkapp.com/email
# LUCENT_MAIL_AUTH_HEADER=X-Postmark-Server-Token
# LUCENT_MAIL_AUTH_SCHEME=
# LUCENT_MAIL_FROM="Lucent <noreply@yourdomain.com>"

# Option C: SMTP Relay (Amazon SES, Mailgun, SendGrid SMTP)
# LUCENT_MAIL_TRANSPORT=smtp
# LUCENT_SMTP_URL=smtp://email-smtp.us-east-1.amazonaws.com:587
# LUCENT_SMTP_USER=AKIA...
# LUCENT_SMTP_PASSWORD=...
# LUCENT_MAIL_FROM="Lucent <noreply@yourdomain.com>"

# --- LiveKit Hosted Voice & Meetings ---
LUCENT_LIVEKIT_URL=wss://your-project.livekit.cloud
LUCENT_LIVEKIT_API_KEY=your_livekit_api_key
LUCENT_LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Stripe Billing (Optional for Paid Tiers) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Observability & Reverse Proxy ---
# Set to 1 if behind Nginx / Cloudflare / AWS ALB to trust X-Forwarded-For:
LUCENT_TRUST_PROXY=1
