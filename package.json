{
  "name": "lucent",
  "version": "0.0.0",
  "private": true,
  "description": "AI-Native Voice Visual Workspace",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "server": "npm run start -w @lucent/server",
    "web": "npm run dev -w @lucent/web",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "smoke": "npm run smoke -w @lucent/server",
    "load:smoke": "node scripts/load-test/runner.mjs --profile=smoke",
    "load:baseline": "node scripts/load-test/runner.mjs --profile=baseline",
    "load:target": "node scripts/load-test/runner.mjs --profile=target",
    "load:hot-board": "node scripts/load-test/runner.mjs --profile=hot-board",
    "load:ai-storm": "node scripts/load-test/runner.mjs --profile=ai-storm",
    "load:workflows": "node scripts/load-test/runner.mjs --profile=workflows",
    "load:resilience": "node scripts/load-test/runner.mjs --profile=resilience",
    "load:capacity": "node scripts/load-test/runner.mjs --profile=capacity",
    "load:all": "node scripts/load-test/runner.mjs --profile=all",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "9.17.0",
    "drizzle-orm": "0.45.2",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "kill-port": "^2.0.1",
    "prettier": "3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.19.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3"
  },
  "//": "overrides.shell-quote: pinned because 1.8.4-1.10.0 carry GHSA-pqg4-j6r4-53mv (critical command injection in quote()) and the resolved tree sat at 1.10.0, failing the CI `audit shipped dependencies` gate. It arrives transitively via drizzle-orm -> gel (drizzle's optional EdgeDB driver; this repo only ever uses pg) and @changesets/cli -> launch-editor. Forcing the patched release avoids the breaking drizzle-orm bump the audit report otherwise recommends.",
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
