{
  "name": "lucent",
  "version": "0.0.0",
  "private": true,
  "description": "AI-Native Voice Visual Workspace",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "server": "npm run start -w @lucent/server",
    "web": "npm run dev -w @lucent/web",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "smoke": "npm run smoke -w @lucent/server",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "drizzle-orm": "0.45.2",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "kill-port": "^2.0.1",
    "prettier": "3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.19.0",
    "vitest": "^2.1.8"
  }
}
